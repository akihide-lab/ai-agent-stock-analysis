# Optional: directory containing macro CSV files for scripts/update_macro_from_existing.py
# STOCK_MACRO_SOURCE_DATA=data/import

# Database selection
DB_TYPE=sqlite

# SQLite
SQLITE_DB_PATH=./data/market_analysis.db

# PostgreSQL
# POSTGRES_* is the preferred form. PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD/PGSSLMODE
# are also accepted by the connection helper for local compatibility.
POSTGRES_HOST=your-rds-endpoint
POSTGRES_PORT=5432
POSTGRES_DB=market_analysis_test
POSTGRES_USER=your-user
POSTGRES_PASSWORD=your-password
POSTGRES_SSLMODE=require

# S3 report upload
ENABLE_S3_UPLOAD=false
S3_BUCKET_NAME=
S3_REPORT_PREFIX=reports
